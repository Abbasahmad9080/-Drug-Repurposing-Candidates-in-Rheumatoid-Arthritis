# ==========================================================
# 21. MACHINE LEARNING DATASET
# ==========================================================

# Use normalized expression data

ml_matrix <- as.data.frame(
  t(vst_matrix)
)

ml_matrix$Group <- metadata$Group

ml_matrix$Group <- factor(
  ml_matrix$Group,
  levels = c("Control", "RA")
)

# Keep genes that are available
ml_genes <- setdiff(
  colnames(ml_matrix),
  "Group"
)

# Remove zero-variance predictors
nzv <- nearZeroVar(
  ml_matrix[, ml_genes],
  saveMetrics = TRUE
)

ml_genes <- ml_genes[
  !nzv$zeroVar
]

ml_data <- ml_matrix[
  ,
  c(ml_genes, "Group")
]


# ==========================================================
# 22. LASSO LOGISTIC REGRESSION
# ==========================================================

x <- as.matrix(
  ml_data[, ml_genes]
)

y <- ifelse(
  ml_data$Group == "RA",
  1,
  0
)

cv_lasso <- cv.glmnet(
  x,
  y,
  family = "binomial",
  alpha = 1,
  nfolds = min(10, nrow(x)),
  type.measure = "class"
)

pdf(
  "RA_Analysis/06_LASSO/LASSO_CV.pdf",
  width = 8,
  height = 6
)

plot(cv_lasso)

dev.off()

lasso_model <- glmnet(
  x,
  y,
  family = "binomial",
  alpha = 1
)

lasso_coef <- coef(
  cv_lasso,
  s = "lambda.min"
)

lasso_genes <- rownames(
  lasso_coef
)[
  as.numeric(lasso_coef) != 0
]

lasso_genes <- setdiff(
  lasso_genes,
  "(Intercept)"
)

write.csv(
  data.frame(Gene = lasso_genes),
  "RA_Analysis/06_LASSO/LASSO_Selected_Genes.csv",
  row.names = FALSE
)


# ==========================================================
# 23. RANDOM FOREST
# ==========================================================

# Select DEGs to reduce dimensionality

candidate_genes <- intersect(
  deg$Gene,
  colnames(ml_data)
)

rf_data <- ml_data[
  ,
  c(candidate_genes, "Group")
]

rf_model <- randomForest(
  Group ~ .,
  data = rf_data,
  ntree = 1000,
  importance = TRUE
)

rf_importance <- as.data.frame(
  importance(rf_model)
)

rf_importance$Gene <- rownames(
  rf_importance
)

rf_importance <- rf_importance %>%
  arrange(desc(MeanDecreaseGini))

write.csv(
  rf_importance,
  "RA_Analysis/07_RandomForest/RandomForest_Importance.csv",
  row.names = FALSE
)


# ==========================================================
# 24. TOP RANDOM FOREST GENES
# ==========================================================

top_rf <- rf_importance %>%
  head(30)

pdf(
  "RA_Analysis/07_RandomForest/Top_RF_Genes.pdf",
  width = 9,
  height = 7
)

ggplot(
  top_rf,
  aes(
    x = reorder(Gene, MeanDecreaseGini),
    y = MeanDecreaseGini
  )
) +
  geom_col() +
  coord_flip() +
  theme_classic() +
  labs(
    title = "Top Random Forest Features",
    x = "Gene",
    y = "Mean Decrease in Gini"
  )

dev.off()


# ==========================================================
# 25. SVM-RFE
# ==========================================================

# Use candidate DEGs

svm_genes <- candidate_genes

svm_data <- ml_data[
  ,
  c(svm_genes, "Group")
]

ctrl <- rfeControl(
  functions = caretFuncs,
  method = "LOOCV",
  verbose = FALSE
)

sizes <- unique(
  c(
    2,
    3,
    4,
    5,
    10,
    20,
    30
  )
)

sizes <- sizes[
  sizes <= length(svm_genes)
]

svm_rfe <- rfe(
  x = svm_data[, svm_genes],
  y = svm_data$Group,
  sizes = sizes,
  rfeControl = ctrl
)

pdf(
  "RA_Analysis/08_SVM_RFE/SVM_RFE.pdf",
  width = 8,
  height = 6
)

plot(svm_rfe)

dev.off()

svm_selected <- predictors(
  svm_rfe
)

write.csv(
  data.frame(Gene = svm_selected),
  "RA_Analysis/08_SVM_RFE/SVM_RFE_Selected_Genes.csv",
  row.names = FALSE
)


# ==========================================================
# 26. CONSENSUS BIOMARKERS
# ==========================================================

rf_genes <- rf_importance$Gene

consensus <- Reduce(
  intersect,
  list(
    lasso_genes,
    rf_genes,
    svm_selected
  )
)

write.csv(
  data.frame(Gene = consensus),
  "RA_Analysis/09_Biomarker_Panel/Consensus_Genes.csv",
  row.names = FALSE
)

print(consensus)


# ==========================================================
# 27. FOUR-GENE PANEL
# ==========================================================

four_gene_panel <- c(
  "IL1B",
  "TNF",
  "IL6",
  "CTNNB1"
)

available_panel <- intersect(
  four_gene_panel,
  rownames(vst_matrix)
)

print(available_panel)

panel_expression <- t(
  vst_matrix[
    available_panel,
    ,
    drop = FALSE
  ]
)

panel_expression <- as.data.frame(
  panel_expression
)

panel_expression$Group <- metadata$Group

write.csv(
  panel_expression,
  "RA_Analysis/09_Biomarker_Panel/Four_Gene_Panel_Expression.csv"
)


# ==========================================================
# 28. ROC ANALYSIS — INDIVIDUAL GENES
# ==========================================================

roc_results <- list()

for (gene in available_panel) {

  expression <- as.numeric(
    vst_matrix[gene, ]
  )

  roc_obj <- roc(
    response = metadata$Group,
    predictor = expression,
    levels = c("Control", "RA"),
    direction = "<"
  )

  auc_value <- auc(roc_obj)

  roc_results[[gene]] <- list(
    ROC = roc_obj,
    AUC = as.numeric(auc_value)
  )
}

roc_table <- data.frame(
  Gene = names(roc_results),
  AUC = sapply(
    roc_results,
    function(x) x$AUC
  )
)

write.csv(
  roc_table,
  "RA_Analysis/10_ROC/Individual_Gene_AUC.csv",
  row.names = FALSE
)


# ==========================================================
# 29. COMBINED ROC PLOT
# ==========================================================

pdf(
  "RA_Analysis/10_ROC/Individual_Gene_ROC.pdf",
  width = 8,
  height = 7
)

plot(
  roc_results[[1]]$ROC,
  main = "ROC Analysis of Four-Gene Biomarker Panel"
)

if (length(roc_results) > 1) {

  for (i in 2:length(roc_results)) {

    lines(
      roc_results[[i]]$ROC
    )
  }
}

legend(
  "bottomright",
  legend = paste0(
    names(roc_results),
    " AUC = ",
    round(
      sapply(
        roc_results,
        function(x) x$AUC
      ),
      3
    )
  )
)

dev.off()


# ==========================================================
# 30. FOUR-GENE COMBINED MODEL
# ==========================================================

panel_df <- as.data.frame(
  t(vst_matrix[available_panel, ])
)

panel_df$Group <- metadata$Group

panel_model <- glm(
  Group ~ .,
  data = panel_df,
  family = binomial
)

panel_probability <- predict(
  panel_model,
  type = "response"
)

panel_roc <- roc(
  metadata$Group,
  panel_probability,
  levels = c("Control", "RA")
)

panel_auc <- auc(
  panel_roc
)

cat(
  "Four-gene panel AUC:",
  panel_auc,
  "\n"
)

write.csv(
  data.frame(
    Model = "IL1B_TNF_IL6_CTNNB1",
    AUC = as.numeric(panel_auc)
  ),
  "RA_Analysis/10_ROC/Four_Gene_Panel_AUC.csv",
  row.names = FALSE
)


# ==========================================================
# 31. FOUR-GENE ROC FIGURE
# ==========================================================

pdf(
  "RA_Analysis/10_ROC/Four_Gene_Combined_ROC.pdf",
  width = 7,
  height = 7
)

plot(
  panel_roc,
  main = paste0(
    "Four-Gene Diagnostic Panel\nAUC = ",
    round(panel_auc, 3)
  ),
  lwd = 3
)

dev.off()


# ==========================================================
# 32. CLASSIFIER COMPARISON
# ==========================================================

# Four-gene expression matrix

classifier_data <- panel_df

ctrl <- trainControl(
  method = "LOOCV",
  classProbs = TRUE,
  savePredictions = "final"
)


# Logistic Regression

set.seed(123)

model_glm <- train(
  Group ~ .,
  data = classifier_data,
  method = "glm",
  family = "binomial",
  trControl = ctrl
)


# Random Forest

set.seed(123)

model_rf <- train(
  Group ~ .,
  data = classifier_data,
  method = "rf",
  trControl = ctrl
)


# Naive Bayes

set.seed(123)

model_nb <- train(
  Group ~ .,
  data = classifier_data,
  method = "naive_bayes",
  trControl = ctrl
)


# SVM

set.seed(123)

model_svm <- train(
  Group ~ .,
  data = classifier_data,
  method = "svmRadial",
  trControl = ctrl
)


# ==========================================================
# 33. SAVE MACHINE LEARNING MODELS
# ==========================================================

saveRDS(
  model_glm,
  "RA_Analysis/09_Biomarker_Panel/GLM_Model.rds"
)

saveRDS(
  model_rf,
  "RA_Analysis/09_Biomarker_Panel/RF_Model.rds"
)

saveRDS(
  model_nb,
  "RA_Analysis/09_Biomarker_Panel/NaiveBayes_Model.rds"
)

saveRDS(
  model_svm,
  "RA_Analysis/09_Biomarker_Panel/SVM_Model.rds"
)


# ==========================================================
# 34. EXPORT FINAL RESULTS
# ==========================================================

write.xlsx(
  list(
    All_DEGs = res,
    Significant_DEGs = deg,
    Upregulated = upregulated,
    Downregulated = downregulated,
    LASSO = data.frame(Gene = lasso_genes),
