set.seed(1234)


# ==========================================================
# 1. CREATE OUTPUT DIRECTORIES
# ==========================================================

dir.create("RA_Analysis", showWarnings = FALSE)

folders <- c(
  "01_QC",
  "02_Normalization",
  "03_DEG",
  "04_Enrichment",
  "05_PPI",
  "06_LASSO",
  "07_RandomForest",
  "08_SVM_RFE",
  "09_Biomarker_Panel",
  "10_ROC",
  "11_Drug_Repurposing",
  "12_Final_Figures",
  "13_Final_Tables"
)

for (x in folders) {
  dir.create(file.path("RA_Analysis", x),
             recursive = TRUE,
             showWarnings = FALSE)
}


# ==========================================================
# 2. IMPORT RAW COUNT DATA
# ==========================================================

counts <- read.csv(
  "counts.csv",
  header = TRUE,
  row.names = 1,
  check.names = FALSE
)

metadata <- read.csv(
  "metadata.csv",
  header = TRUE,
  stringsAsFactors = FALSE
)

head(counts)
head(metadata)

# Check dimensions
dim(counts)
dim(metadata)

# ==========================================================
# 3. MATCH SAMPLE NAMES
# ==========================================================

metadata$SampleID <- as.character(metadata$SampleID)

common_samples <- intersect(
  colnames(counts),
  metadata$SampleID
)

counts <- counts[, common_samples]

metadata <- metadata[
  match(common_samples, metadata$SampleID),
]

rownames(metadata) <- metadata$SampleID

metadata$Group <- factor(
  metadata$Group,
  levels = c("Control", "RA")
)

# Check
table(metadata$Group)

stopifnot(
  all(colnames(counts) == rownames(metadata))
)


# ==========================================================
# 4. BASIC COUNT QC
# ==========================================================

library_size <- colSums(counts)

qc_table <- data.frame(
  Sample = names(library_size),
  Library_Size = library_size,
  Group = metadata$Group
)

write.csv(
  qc_table,
  "RA_Analysis/01_QC/Library_Size.csv",
  row.names = FALSE
)

pdf(
  "RA_Analysis/01_QC/Library_Size.pdf",
  width = 8,
  height = 6
)

barplot(
  library_size,
  las = 2,
  main = "RNA-seq Library Size",
  ylab = "Total Counts"
)

dev.off()


# ==========================================================
# 5. FILTER LOW-COUNT GENES
# ==========================================================

keep <- rowSums(counts >= 10) >= 3

counts_filtered <- counts[keep, ]

cat(
  "Genes before filtering:",
  nrow(counts),
  "\n"
)

cat(
  "Genes after filtering:",
  nrow(counts_filtered),
  "\n"
)

write.csv(
  counts_filtered,
  "RA_Analysis/02_Normalization/Filtered_Counts.csv"
)


# ==========================================================
# 6. DESeq2 OBJECT
# ==========================================================

dds <- DESeqDataSetFromMatrix(
  countData = round(counts_filtered),
  colData = metadata,
  design = ~ Group
)

dds <- DESeq(dds)

saveRDS(
  dds,
  "RA_Analysis/02_Normalization/DESeq2_Object.rds"
)


# ==========================================================
# 7. VST NORMALIZATION
# ==========================================================

vsd <- vst(
  dds,
  blind = FALSE
)

vst_matrix <- assay(vsd)

write.csv(
  vst_matrix,
  "RA_Analysis/02_Normalization/VST_Normalized_Expression.csv"
)


# ==========================================================
# 8. PCA
# ==========================================================

pdf(
  "RA_Analysis/01_QC/PCA.pdf",
  width = 8,
  height = 6
)

pcaData <- plotPCA(
  vsd,
  intgroup = "Group",
  returnData = TRUE
)

percentVar <- round(
  100 * attr(pcaData, "percentVar")
)

ggplot(
  pcaData,
  aes(
    x = PC1,
    y = PC2,
    color = Group,
    label = name
  )
) +
  geom_point(size = 4) +
  labs(
    title = "PCA of CD14+ Monocyte RNA-seq Data",
    x = paste0("PC1: ", percentVar[1], "%"),
    y = paste0("PC2: ", percentVar[2], "%")
  ) +
  theme_classic()

dev.off()


# ==========================================================
# 9. SAMPLE CORRELATION HEATMAP
# ==========================================================

sample_cor <- cor(vst_matrix)

pdf(
  "RA_Analysis/01_QC/Sample_Correlation.pdf",
  width = 8,
  height = 7
)

pheatmap(
  sample_cor,
  main = "Sample Correlation",
  annotation_col = metadata["Group"]
)

dev.off()


# ==========================================================
# 10. DIFFERENTIAL EXPRESSION ANALYSIS
# ==========================================================

res <- results(
  dds,
  contrast = c("Group", "RA", "Control"),
  alpha = 0.05
)

res <- as.data.frame(res)

res$Gene <- rownames(res)

res <- res %>%
  arrange(padj)

write.csv(
  res,
  "RA_Analysis/03_DEG/All_DEGs.csv",
  row.names = FALSE
)


# ==========================================================
# 11. IDENTIFY SIGNIFICANT DEGs
# ==========================================================

deg <- res %>%
  filter(
    !is.na(padj),
    padj < 0.05,
    abs(log2FoldChange) >= 1
  )

upregulated <- deg %>%
  filter(log2FoldChange >= 1)

downregulated <- deg %>%
  filter(log2FoldChange <= -1)

cat("Total DEGs:", nrow(deg), "\n")
cat("Upregulated:", nrow(upregulated), "\n")
cat("Downregulated:", nrow(downregulated), "\n")

write.csv(
  deg,
  "RA_Analysis/03_DEG/Significant_DEGs.csv",
  row.names = FALSE
)

write.csv(
  upregulated,
  "RA_Analysis/03_DEG/Upregulated_DEGs.csv",
  row.names = FALSE
)

write.csv(
  downregulated,
  "RA_Analysis/03_DEG/Downregulated_DEGs.csv",
  row.names = FALSE
)


# ==========================================================
# 12. VOLCANO PLOT
# ==========================================================

res$Significance <- "Not significant"

res$Significance[
  res$padj < 0.05 &
  res$log2FoldChange >= 1
] <- "Upregulated"

res$Significance[
  res$padj < 0.05 &
  res$log2FoldChange <= -1
] <- "Downregulated"

pdf(
  "RA_Analysis/03_DEG/Volcano_Plot.pdf",
  width = 9,
  height = 7
)

ggplot(
  res,
  aes(
    x = log2FoldChange,
    y = -log10(padj),
    color = Significance
  )
) +
  geom_point(alpha = 0.6) +
  geom_vline(
    xintercept = c(-1, 1),
    linetype = "dashed"
  ) +
  geom_hline(
    yintercept = -log10(0.05),
    linetype = "dashed"
  ) +
  theme_classic() +
  labs(
    title = "Differentially Expressed Genes",
    x = "log2 Fold Change",
    y = "-log10 Adjusted P-value"
  )

dev.off()


# ==========================================================
# 13. HEATMAP OF TOP DEGs
# ==========================================================

top_genes <- deg %>%
  arrange(padj) %>%
  head(50) %>%
  pull(Gene)

heatmap_matrix <- vst_matrix[
  intersect(top_genes, rownames(vst_matrix)),
]

heatmap_matrix <- t(
  scale(t(heatmap_matrix))
)

pdf(
  "RA_Analysis/03_DEG/Top50_DEG_Heatmap.pdf",
  width = 9,
  height = 12
)

pheatmap(
  heatmap_matrix,
  annotation_col = metadata["Group"],
  show_rownames = TRUE,
  show_colnames = TRUE,
  main = "Top 50 Differentially Expressed Genes"
)

dev.off()


# ==========================================================
# 14. GENE ID CONVERSION
# ==========================================================

gene_symbols <- deg$Gene

gene_conversion <- bitr(
  gene_symbols,
  fromType = "SYMBOL",
  toType = "ENTREZID",
  OrgDb = org.Hs.eg.db
)

write.csv(
  gene_conversion,
  "RA_Analysis/04_Enrichment/Gene_ID_Conversion.csv",
  row.names = FALSE
)


# ==========================================================
# 15. GO ENRICHMENT
# ==========================================================

ego <- enrichGO(
  gene = gene_conversion$ENTREZID,
  OrgDb = org.Hs.eg.db,
  keyType = "ENTREZID",
  ont = "ALL",
  pAdjustMethod = "BH",
  pvalueCutoff = 0.05,
  qvalueCutoff = 0.05,
  readable = TRUE
)

write.csv(
  as.data.frame(ego),
  "RA_Analysis/04_Enrichment/GO_Enrichment.csv",
  row.names = FALSE
)


# ==========================================================
# 16. GO DOTPLOT
# ==========================================================

pdf(
  "RA_Analysis/04_Enrichment/GO_Dotplot.pdf",
  width = 10,
  height = 8
)

dotplot(
  ego,
  showCategory = 20
)

dev.off()


# ==========================================================
# 17. KEGG ENRICHMENT
# ==========================================================

ekegg <- enrichKEGG(
  gene = gene_conversion$ENTREZID,
  organism = "hsa",
  pvalueCutoff = 0.05
)

write.csv(
  as.data.frame(ekegg),
  "RA_Analysis/04_Enrichment/KEGG_Enrichment.csv",
  row.names = FALSE
)


# ==========================================================
# 18. KEGG DOTPLOT
# ==========================================================

pdf(
  "RA_Analysis/04_Enrichment/KEGG_Dotplot.pdf",
  width = 10,
  height = 8
)

dotplot(
  ekegg,
  showCategory = 20
)

dev.off()


# ==========================================================
# 19. PPI INPUT
# ==========================================================

# Export significant DEGs for STRING/PPI analysis

ppi_genes <- unique(deg$Gene)

write.table(
  ppi_genes,
  "RA_Analysis/05_PPI/PPI_Genes.txt",
  row.names = FALSE,
  col.names = FALSE,
  quote = FALSE
)


